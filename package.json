{
  "name": "perceptual-mechanics",
  "version": "7.8.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "npm test --workspaces --if-present",
    "preview": "vite preview",
    "verify-links": "node scripts/verify-links.mjs",
    "verify-resonances": "node scripts/verify-resonances.mjs",
    "verify-scroll-marks": "node scripts/verify-scroll-marks.mjs",
    "verify-landing": "node scripts/verify-landing.mjs",
    "verify-bench": "node scripts/verify-bench.mjs",
    "verify-euphonia": "node scripts/verify-euphonia.mjs",
    "verify-euphonia-map": "node scripts/verify-euphonia-map.mjs",
    "verify-euphonia-srd": "node scripts/verify-euphonia-srd.mjs",
    "verify-euphonia-builder": "node scripts/verify-euphonia-builder.mjs",
    "euphonia:effects": "node scripts/euphonia-effects.mjs",
    "euphonia:refresh": "python3 \"${CLASS_KIT:-$HOME/Documents/class-kit}/site_export.py\" src/euphonia --sheets public/euphonia/sheets && node scripts/verify-euphonia.mjs"
  },
  "dependencies": {
    "bardjs": "*",
    "d3-geo": "3.1.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "vite": "^8.3.4"
  }
}
