# Canonical-host enforcement, 2026-07-28. The site's own <link rel="canonical">
# (index.html) has always pointed at https://perceptualmechanics.com/, but
# nothing server-side ever enforced it — http://, https://www., and
# /index.html all served the exact same page with no redirect. Google Search
# Console's own "Page indexing" report flagged the result: four URLs bucketed
# under "Alternate page with proper canonical tag" (Scott, 2026-07-28
# screenshot). Not a broken-site bug -- the canonical tag was already doing
# its job, keeping duplicates out of the index -- but relying on it alone
# means any links pointing at a non-canonical variant never consolidate
# their SEO weight onto the real URL, and Google keeps re-crawling
# duplicates instead of just following a redirect once. Real 301s fix both.
#
# Combines the https + apex-domain checks into one rule so http://www...
# takes a single hop straight to the canonical URL, not two.
RewriteEngine On

RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.perceptualmechanics\.com$ [NC]
RewriteRule ^(.*)$ https://perceptualmechanics.com/$1 [L,R=301]

# /index.html -> / (THE_REQUEST, not the rewritten path, so this can't loop
# against Vite's own module-script reference to /src/main.js etc.)
RewriteCond %{THE_REQUEST} \s/+index\.html[?\s]
RewriteRule ^index\.html$ / [L,R=301]

# Same intent, for the static text pages added 2026-07-29: each one is served
# as <dir>/index.html, so /text/scroll/index.html and /text/scroll/ are the
# same page at two URLs — exactly the duplicate the rule above exists to
# collapse. Deliberately kept as its own rule scoped to ^text/ rather than
# generalizing the proven root rule to match any directory: a mistake in an
# untestable Apache regex that only touches /text/ costs a few new pages,
# whereas the same mistake in the root rule could loop the homepage itself.
# %1 is the captured sub-path ('scroll/', or empty for /text/index.html).
RewriteCond %{THE_REQUEST} \s/+text/(([^\s?]*/)?)index\.html[?\s]
RewriteRule ^text/(.*/)?index\.html$ /text/%1 [L,R=301]

# Long-lived caching for self-hosted fonts, 2026-08-31. Font files under
# /fonts/ are the woff2s that used to be served (and cached) by Google's
# CDN — see styles/main.css's "Self-hosted fonts" block. They're immutable
# in practice (a font swap means new filenames, per Vite/this repo's own
# convention elsewhere, not overwriting an existing one), so it's safe to
# cache them for a year with `immutable`, matching what Google's own CDN
# effectively did for visitors before this migration.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Content Security Policy, 2026-09-01. Shipped Report-Only first (v3.12.0),
# then switched to enforcing here after a fully clean Report-Only pass: all
# ten scenes opened via real pointer clicks, all 11 pmGlimpse hash-allowlisted
# handlers hovered, and Library's video facade + iframe + Open Library cover
# image all exercised — zero policy violations in the console the entire
# time. Enforcing now means a real violation actually blocks the resource,
# not just logs it.
#
# Full external-origin audit before writing this (don't assume, confirm):
# self-hosted fonts left the site with almost no external origins, except
# library.js's YouTube embed/thumbnail and Open Library cover images — both
# real, both allowed explicitly below.
#
# script-src: zero eval()/new Function() anywhere, and — contrary to this
# policy's own original worry — every real interactive element already uses
# addEventListener, not inline on* attributes. The one true exception is
# pmGlimpse's onmouseover/onfocus="pmGlimpse('<scene>')" attributes in
# index.html (11 distinct strings, nav icons + landing tiles): allowlisted
# by exact SHA-256 hash via 'unsafe-hashes' rather than relaxing script-src
# with 'unsafe-inline', which would defeat most of CSP's real value for a
# site with no forms/backend/user data to begin with.
#
# style-src: kept at 'self' with zero exceptions. theater.js's reel-hole and
# scroll.js's hand-lettered-jitter effects used to bake Math.random() values
# into style="" attributes (unbounded, not hash-allowlistable); refactored to
# apply them via .style.setProperty()/.style.cssText after DOM insertion
# instead — a JS property assignment, which style-src never restricts, same
# category as the WebGL-overlay-positioning pattern already used elsewhere.
# The few static style="" attributes left (colophon.html, scroll.html) moved
# into real CSS rules/classes.
#
# frame-ancestors 'none': this site is never meant to be embedded in a frame
# on any page, including its own (Scott's call, 2026-09-01) — only enforceable
# via a real header, not a <meta> tag, hence delivering this here rather than
# in index.html.
<IfModule mod_headers.c>
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-hashes' 'sha256-wrGcw4Hh4EADJnjzOcfd5DaWPUIruNgn8nBYgc5yyE8=' 'sha256-zp0uX7PKsea9IkcmQsku4gNaE5Z21TLGMjw1I0X9FGM=' 'sha256-oAZhPI3r1e1alGTJdzYSoEIwmLUIRM8JU1Pz2YPj3+w=' 'sha256-UZaJQeZUGhw8gb3DUVYP2isWNRsYThITn+aHzZ+DemI=' 'sha256-Ugru+QX2p8pU7PRDmF46Xvetac04Y1+/PdaBUcObCBs=' 'sha256-goABNm3NeAhzk+ni9cgu5AyESxrNOSEXuMw0c+2n9i8=' 'sha256-iubMYKz85wEQ/WBzGb4xFlGo1qQEI/PhiZjmBVyVt7Y=' 'sha256-8RTwVgFPnmX0JrXz5Ij4T+a54GOCuZpFKoVXDBSYj7I=' 'sha256-7mkgXz7OJRXXs/g0lSfmO+3bzPiDMzMF37T7ITa9D44=' 'sha256-8ETIdmjbwn670jO3Ay+iom7a0Jzg1nTR8XF2MP6aBYE=' 'sha256-J0nW7LxZhGyHCm+rxtjw9ESL/IaRW96GrrHdDC0yLn8='; style-src 'self'; font-src 'self'; img-src 'self' data: https://i.ytimg.com https://covers.openlibrary.org; connect-src 'self'; frame-src https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
</IfModule>
