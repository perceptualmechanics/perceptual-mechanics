# Canonical-host enforcement, 2026-07-28. The site's own <link rel="canonical">
# (index.html) has always pointed at https://perceptualmechanics.com/, but
# nothing server-side ever enforced it — http://, https://www., and
# /index.html all served the exact same page with no redirect. Google Search
# Console's own "Page indexing" report flagged the result: four URLs bucketed
# under "Alternate page with proper canonical tag" (Scott, 2026-07-28
# screenshot). Not a broken-site bug -- the canonical tag was already doing
# its job, keeping duplicates out of the index -- but relying on it alone
# means any links pointing at a non-canonical variant never consolidate
# their SEO weight onto the real URL, and Google keeps re-crawling
# duplicates instead of just following a redirect once. Real 301s fix both.
#
# Combines the https + apex-domain checks into one rule so http://www...
# takes a single hop straight to the canonical URL, not two.
RewriteEngine On

RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.perceptualmechanics\.com$ [NC]
RewriteRule ^(.*)$ https://perceptualmechanics.com/$1 [L,R=301]

# /index.html -> / (THE_REQUEST, not the rewritten path, so this can't loop
# against Vite's own module-script reference to /src/main.js etc.)
RewriteCond %{THE_REQUEST} \s/+index\.html[?\s]
RewriteRule ^index\.html$ / [L,R=301]

# Same intent, for the static text pages added 2026-07-29: each one is served
# as <dir>/index.html, so /text/scroll/index.html and /text/scroll/ are the
# same page at two URLs — exactly the duplicate the rule above exists to
# collapse. Deliberately kept as its own rule scoped to ^text/ rather than
# generalizing the proven root rule to match any directory: a mistake in an
# untestable Apache regex that only touches /text/ costs a few new pages,
# whereas the same mistake in the root rule could loop the homepage itself.
# %1 is the captured sub-path ('scroll/', or empty for /text/index.html).
RewriteCond %{THE_REQUEST} \s/+text/(([^\s?]*/)?)index\.html[?\s]
RewriteRule ^text/(.*/)?index\.html$ /text/%1 [L,R=301]

# Long-lived caching for self-hosted fonts, 2026-08-31. Font files under
# /fonts/ are the woff2s that used to be served (and cached) by Google's
# CDN — see styles/main.css's "Self-hosted fonts" block. They're immutable
# in practice (a font swap means new filenames, per Vite/this repo's own
# convention elsewhere, not overwriting an existing one), so it's safe to
# cache them for a year with `immutable`, matching what Google's own CDN
# effectively did for visitors before this migration.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
